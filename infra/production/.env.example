# ============================================================
# Portal Ligado Tattoo — produção (VM self-hosted via Docker)
# Copie para `.env` neste mesmo diretório e preencha os valores.
# ============================================================

# --- Domínio ---
# Domínio público (aponta para o IP da VM). Caddy emite HTTPS automático.
SITE_DOMAIN=seu-dominio.com.br
# tunnel,local-ai = publicação sem abrir portas + IA sem custo por chamada.
# direct,local-ai = Caddy com portas 80/443 abertas.
COMPOSE_PROFILES=tunnel,local-ai
CLOUDFLARE_TUNNEL_TOKEN=cole-o-token-do-tunnel

NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://${SITE_DOMAIN}
API_INTERNAL_URL=http://api:3001
PORT_API=3001
# Importante: atrás do Caddy (proxy reverso), confiar em 1 hop.
TRUST_PROXY_HOPS=1

# --- Chave interna entre worker e API (gere um valor aleatório forte) ---
INTERNAL_API_KEY=troque-por-uma-chave-aleatoria-forte

# --- Banco de dados ---
POSTGRES_PASSWORD=troque-por-senha-forte
DATABASE_URL=postgres://portal:${POSTGRES_PASSWORD}@postgres:5432/portal
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=2000
DB_READINESS_TIMEOUT_MS=1000

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Worker ---
WORKER_POLL_INTERVAL_MS=1000
WORKER_SCHEDULER_INTERVAL_MS=30000
WORKER_JOB_RETENTION_DAYS=7
WORKER_HEARTBEAT_STALE_SECONDS=120

# --- IA local (sem cobrança por chamada) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3.5:0.8b
OLLAMA_VOLUME_NAME=repository_ollama_data
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_KEEP_ALIVE=5m
AI_DEFAULT_PROVIDER=ollama
AI_DEFAULT_MODEL=qwen3.5:0.8b
AI_FALLBACK_ORDER=deepseek,openai,anthropic
AI_PAID_FALLBACK_ENABLED=false
# Os adapters pagos e suas rotas continuam disponíveis como fallback.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Segurança ---
ALLOWED_BROWSER_ORIGINS=https://${SITE_DOMAIN}
SESSION_SIGNING_SECRET=troque-por-uma-chave-aleatoria-de-32-caracteres
RATE_LIMIT_HASH_SALT=troque-por-outro-valor-aleatorio
ANALYTICS_HASH_SALT=troque-por-outro-valor-aleatorio

# --- Acesso ao admin ---
# DEV_ADMIN_TOKEN é bloqueado em produção. Sem OIDC, o portal público funciona
# normalmente e o painel administrativo permanece fechado (fail-closed).
DEV_ADMIN_TOKEN=
ADMIN_SESSION_COOKIE=pt_session

# --- OIDC (opcional — substitui o DEV_ADMIN_TOKEN) ---
# Deixe vazio para manter o admin fechado até um provedor OIDC ser configurado.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_ACTOR_ID_CLAIM=sub
OIDC_CAPABILITIES_CLAIM=capabilities
OIDC_CLOCK_TOLERANCE_SECONDS=5
# E-mails que recebem as capabilities administrativas completas somente depois
# de o JWT OIDC ter assinatura, issuer e audience validados.
OIDC_FULL_ADMIN_EMAILS=admin@example.com
ADMIN_LOGOUT_URL=/cdn-cgi/access/logout

# --- Storage de mídia (MinIO via subdomínio HTTPS) ---
OBJECT_STORAGE_ENDPOINT=https://media.${SITE_DOMAIN}
OBJECT_STORAGE_BUCKET=portal-media
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=troque-por-access-key
OBJECT_STORAGE_SECRET_KEY=troque-por-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
MEDIA_PUBLIC_HOST=media.${SITE_DOMAIN}
MEDIA_SIGNED_URL_TTL_SECONDS=3600
