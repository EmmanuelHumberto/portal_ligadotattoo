NODE_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.example.invalid
API_INTERNAL_URL=http://api:3001
PORT_API=3001

DATABASE_URL=postgres://portal:CHANGE_ME@postgres:5432/portal
REDIS_URL=redis://redis:6379

ALLOWED_BROWSER_ORIGINS=https://staging.example.invalid
SESSION_SIGNING_SECRET=CHANGE_ME_MINIMUM_32_RANDOM_CHARACTERS
ANALYTICS_HASH_SALT=CHANGE_ME_RANDOM

# AI Provider Hub — runtime-only. Configure any subset.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_ORDER=anthropic,deepseek
AI_DEFAULT_MODEL=

OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=portal-media-staging
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
MEDIA_PUBLIC_HOST=media-staging.example.invalid

RELEASE_ID=staging-unset
WEB_IMAGE=portal-web:staging
API_IMAGE=portal-api:staging
WORKER_IMAGE=portal-worker:staging
