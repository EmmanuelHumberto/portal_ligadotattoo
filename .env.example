NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
PORT_API=3001
POSTGRES_PORT=5432

DATABASE_URL=postgres://portal:portal_dev@localhost:5432/portal
