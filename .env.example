NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
PORT_API=3001
TRUST_PROXY_HOPS=0
POSTGRES_PORT=5432

DATABASE_URL=postgres://portal:portal_dev@localhost:5432/portal
# Optional synthetic catalog used only for local development and E2E.
BOOTSTRAP_FIXTURES=false
REDIS_URL=redis://localhost:6379
WORKER_POLL_INTERVAL_MS=1000
WORKER_SCHEDULER_INTERVAL_MS=30000
WORKER_JOB_RETENTION_DAYS=7

# Runtime-only AI provider credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=
AI_FALLBACK_ORDER=anthropic,deepseek

ALLOWED_BROWSER_ORIGINS=http://localhost:3000
SESSION_SIGNING_SECRET=replace-in-local-development
RATE_LIMIT_HASH_SALT=replace-with-an-independent-secret-in-production
ANALYTICS_HASH_SALT=replace-in-local-development

# Leave all three blank to keep protected routes in fail-closed mode.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_ACTOR_ID_CLAIM=sub
OIDC_CAPABILITIES_CLAIM=capabilities
OIDC_CLOCK_TOLERANCE_SECONDS=5

MEDIA_PUBLIC_HOST=localhost
MEDIA_SIGNED_URL_TTL_SECONDS=300
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=portal-media
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=portal_dev
OBJECT_STORAGE_SECRET_KEY=portal_dev_secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
